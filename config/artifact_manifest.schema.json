{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_manifest.schema.json",
  "title": "Canonical pipeline artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "artifact_id",
    "schema_version",
    "stage",
    "status",
    "created_by_commit",
    "input_artifact_ids",
    "config_hash",
    "fit_dates",
    "target_dates",
    "decision_time_contract",
    "files",
    "audit",
    "known_limitations"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 3},
    "schema_version": {"type": "string", "minLength": 1},
    "stage": {"enum": ["raw", "stage0", "stage1", "stage2", "stage3", "stage4", "end_to_end"]},
    "status": {"enum": ["canonical", "exploratory", "deprecated"]},
    "created_at": {"type": "string"},
    "created_by_commit": {"type": "string", "minLength": 7},
    "input_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "config_hash": {"type": "string", "minLength": 8},
    "fit_dates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "target_dates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_time_contract": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "size_bytes"],
        "properties": {
          "role": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "row_count": {"type": ["integer", "null"], "minimum": 0},
          "schema_hash": {"type": ["string", "null"]}
        }
      }
    },
    "field_roles": {"type": "object", "additionalProperties": {"enum": ["pre_dispatch_feature", "predicted_output", "post_trip_realized_label", "evaluation_only", "identifier", "metadata"]}},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
        "path": {"type": "string"},
        "sha256": {"type": ["string", "null"]}
      }
    },
    "supersedes_artifact_id": {"type": ["string", "null"]},
    "known_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
