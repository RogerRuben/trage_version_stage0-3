    "lcs": {
      "name": "longitudinal_control_stress",
      "status": "review_candidate",
      "threshold_status": "review_candidate",
      "source_scope": "direct_observed_intervals_within_traversal",
      "minimum_direct_intervals_per_traversal": 3,
      "minimum_observed_time_s": 6.0,
      "minimum_direct_observed_distance_m": 10.0,
      "maximum_adjacent_gap_s": 6.0,
      "low_speed_mps": 5.0,
      "stop_speed_mps": 1.0,
      "speed_cv_scale": 1.0,
      "acceleration_rms_scale_mps2": 1.0,
      "minimum_acceleration_pairs": 2,
      "maximum_physical_speed_mps": 75.0,
      "maximum_absolute_acceleration_mps2": 8.0,
      "components": {
        "crawl_time_share": {
          "weight": 0.25,
          "range": [
            0.0,
            1.0
          ]
        },
        "stop_time_share": {
          "weight": 0.25,
          "range": [
            0.0,
            1.0
          ]
        },
        "speed_cv_bounded": {
          "weight": 0.25,
          "transform": "x/(x+speed_cv_scale)",
          "input_lower_bound": 0.0
        },
        "acceleration_rms_bounded": {
          "weight": 0.25,
          "transform": "x/(x+acceleration_rms_scale_mps2)",
          "input_lower_bound": 0.0
        }
      },
      "raw_formula": "weighted_mean_of_available_components_only_if_all_four_components_available",
      "missing_policy": "lcs_available_false_and_lcs_values_na",
      "review_requirements": [
        "threshold_sensitivity",
        "repeat_traversal_reliability",
        "sampling_interval_sensitivity",
        "manual_stop_go_case_review"
      ]
    },
    "rts": {
      "name": "reliability_tail_delay_stress",
      "status": "review_candidate",
      "threshold_status": "review_candidate",
      "source_scope": "direct_observed_intervals_with_train_fitted_reference",
      "minimum_direct_observed_time_s": 3.0,
      "minimum_direct_observed_distance_m": 10.0,
      "maximum_direct_speed_mps": 75.0,
      "minimum_reference_sample_size": 100,
      "sec_per_m_clip": [
        0.01,
        10.0
      ],
      "excess_time_ratio_formula": "max((observed_sec_per_m-reference_sec_per_m)/reference_sec_per_m,0)",
      "raw_formula": "excess_time_ratio/(excess_time_ratio+1)",
      "tail_event_percentile_threshold": 0.9,
      "missing_policy": "rts_available_false_and_rts_values_na",
      "review_requirements": [
        "train_only_reference_audit",
        "fallback_support_audit",
        "temporal_holdout_stability",
        "reference_bin_sensitivity"
